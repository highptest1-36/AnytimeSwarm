# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# large generated artefacts (regenerable from seeds; checksums go to the run manifests)
*.pkl
*.ulg
*.bag
*.db3
**/data/
**/traces/
**/missions/

# ROS 2 build output
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# raw install / simulator logs (keep the short .txt summaries)
setup/logs/*.log

# reproduction working copy: regenerable outputs (summaries are copied to results/g0)
repro/data*/
repro/results*/
repro/models/improvement_model_*.json
repro/configs/g0_*.yaml
paper_journal/*.aux
paper_journal/*.log
paper_journal/*.out
paper_journal/*.blg
paper_journal/*.spl
paper_journal/figures_src/*.aux
paper_journal/figures_src/*.log

# illustrative tier C flights: raw PX4 logs (~100 MB each) and raw GUI captures are not versioned
results/tier_c/demo/ulog/
results/tier_c/demo/shots/
results/tier_c/demo/.start_*

# Elsevier manuscript: previous paper used only as template reference, author photos, LaTeX build files
paper_journal/overleaf_revised_manuscript/_previous_paper_reference/
paper_journal/AST_submission/Vitae.docx
paper_journal/AST_submission/Cover_letter.docx
paper_journal/AST_submission/Declaration_of_competing_interests.docx
paper_journal/**/*.aux
paper_journal/**/*.log
paper_journal/**/*.out
paper_journal/**/*.blg
paper_journal/**/*.abs
