# raw install / simulator logs (keep the short .txt summaries)
setup/logs/*.log

# reproduction working copy: regenerable outputs (summaries are copied to results/g0)
repro/data*/
repro/results*/
repro/models/improvement_model_*.json
repro/configs/g0_*.yaml
